<Window x:Class="RestaurantHR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="نظام إدارة موارد مطعم" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="Segoe UI" FlowDirection="RightToLeft">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الشريط العلوي -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="SpaceBetween">
            <TextBlock Text="إدارة الموظفين (الرئيسية)" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="تصدير إلى Excel" Margin="8,0" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                <Button Content="+ إضافة موظف جديد" Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </StackPanel>

        <!-- الجدول (يشبه الإكسل لكن أكثر أناقة) -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" 
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  Style="{StaticResource MaterialDesignDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" />
                <DataGridTextColumn Header="اسم الموظف" Binding="{Binding Name}" />
                <DataGridTextColumn Header="المسمى الوظيفي" Binding="{Binding Role}" />
                <DataGridTextColumn Header="الوردية (Shift)" Binding="{Binding Shift}" />
                <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding BaseSalary}" />
                <DataGridTextColumn Header="أيام الحضور" Binding="{Binding AttendanceDays}" />
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
